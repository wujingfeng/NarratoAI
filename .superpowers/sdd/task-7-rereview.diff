 .dashboard-section-heading h2 { margin: 0; font-size: 19px; font-weight: 530; }
 .dashboard-section-heading button { display: inline-flex; align-items: center; gap: 5px; padding: 6px; border: 0; background: transparent; color: var(--dashboard-text-muted); cursor: pointer; }
 .dashboard-section-heading button:hover { color: #fff; }
 
 .recent-projects__list { display: grid; gap: 9px; margin-top: 17px; }
 .recent-projects__item { display: grid; grid-template-columns: 112px minmax(0, 1fr) 90px; align-items: center; min-height: 83px; gap: 14px; width: 100%; padding: 4px 11px 4px 4px; border: 1px solid rgba(117, 139, 177, 0.18); border-radius: 8px; background: rgba(9, 17, 31, 0.66); color: var(--dashboard-text); text-align: left; cursor: pointer; }
 .recent-projects__item:hover { border-color: var(--dashboard-border-strong); background: var(--dashboard-panel-hover); }
 .dashboard-thumbnail { display: block; overflow: hidden; border-radius: 5px; background: #111827; }
 .recent-projects__item .dashboard-thumbnail { width: 112px; height: 73px; }
 .dashboard-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
+.dashboard-shell img[hidden] { display: none; }
 .dashboard-thumbnail__fallback { display: grid; place-items: center; width: 100%; height: 100%; padding: 8px; background: linear-gradient(145deg, #18243b, #0b1323); color: #8290a8; font-size: 12px; text-align: center; }
 .recent-projects__details { display: grid; gap: 10px; min-width: 0; }
 .recent-projects__details strong { overflow: hidden; font-size: 16px; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
 .recent-projects__details small { color: var(--dashboard-text-muted); font-size: 12px; }
 .recent-projects__status { display: grid; justify-items: end; gap: 7px; font-size: 14px; }
 .recent-projects__credits { color: var(--dashboard-text-muted); font-size: 11px; font-weight: 400; }
 .recent-projects__status--complete { color: var(--dashboard-success); }
 .recent-projects__status--processing { color: var(--dashboard-warning); }
 .recent-projects__status--draft { color: var(--dashboard-cyan); }
 .recent-projects__status progress { width: 70px; height: 4px; overflow: hidden; border: 0; border-radius: 4px; accent-color: var(--dashboard-warning); }
