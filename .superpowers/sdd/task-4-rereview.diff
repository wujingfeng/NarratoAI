+.dashboard-thumbnail { display: block; overflow: hidden; border-radius: 5px; background: #111827; }
+.recent-projects__item .dashboard-thumbnail { width: 112px; height: 73px; }
+.dashboard-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
+.dashboard-thumbnail__fallback { display: grid; place-items: center; width: 100%; height: 100%; padding: 8px; background: linear-gradient(145deg, #18243b, #0b1323); color: #8290a8; font-size: 12px; text-align: center; }
+.recent-projects__details { display: grid; gap: 10px; min-width: 0; }
+.recent-projects__details strong { overflow: hidden; font-size: 16px; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
+.recent-projects__details small { color: var(--dashboard-text-muted); font-size: 12px; }
+.recent-projects__status { display: grid; justify-items: end; gap: 7px; font-size: 14px; }
+.recent-projects__credits { color: var(--dashboard-text-muted); font-size: 11px; font-weight: 400; }
+.recent-projects__status--complete { color: var(--dashboard-success); }
+.recent-projects__status--processing { color: var(--dashboard-warning); }
+.recent-projects__status--draft { color: var(--dashboard-cyan); }
+.recent-projects__status progress { width: 70px; height: 4px; overflow: hidden; border: 0; border-radius: 4px; accent-color: var(--dashboard-warning); }
+
+.credits-overview { position: relative; display: flex; align-items: center; flex-direction: column; padding-inline: 14px; text-align: center; }
+.credits-overview__heading { align-self: stretch; justify-content: flex-start; }
+.credits-overview__icon { display: none; }
+.credits-overview::before,
+.credits-ring {
+  content: "";
+  position: absolute;
+  top: 70px;
+  width: 184px;
+  height: 184px;
+  border-radius: 50%;
+  background: conic-gradient(var(--dashboard-cyan) 0 32%, #2874f0 32% 62%, #7b36dc 62% 82%, rgba(80, 95, 130, 0.22) 82% 100%);
+  -webkit-mask: radial-gradient(circle, transparent 0 64%, #000 65% 73%, transparent 74%);
+  mask: radial-gradient(circle, transparent 0 64%, #000 65% 73%, transparent 74%);
+  filter: drop-shadow(0 0 7px rgba(33, 199, 232, 0.28));
+}
+.credits-ring::after { content: ""; position: absolute; inset: 11px; border-radius: inherit; background: var(--dashboard-surface); }
+.credits-overview__balance-label { position: absolute; top: 185px; margin: 0; color: var(--dashboard-text-muted); font-size: 13px; }
+.credits-overview__balance-value { position: absolute; z-index: 2; top: 145px; font-size: 30px; font-weight: 560; letter-spacing: 0.04em; }
+.credits-overview__usage { position: absolute; bottom: 26px; left: 18px; display: flex; align-items: center; gap: 8px; margin: 0; color: var(--dashboard-text-muted); font-size: 13px; }
+.credits-overview__usage span { width: 8px; height: 8px; border-radius: 50%; background: #7840e7; }
+.credits-overview__action { position: absolute; right: 11px; bottom: 19px; width: 40px; height: 32px; overflow: hidden; border: 0; background: transparent; color: transparent; font-size: 0; cursor: pointer; }
+.credits-overview__action svg { color: var(--dashboard-text-muted); }
+.credits-overview__action:hover svg { color: #fff; transform: translateX(2px); }
+
+.inspiration-panel__list { display: grid; gap: 10px; margin-top: 17px; }
+.inspiration-panel__item { display: grid; grid-template-columns: 104px minmax(0, 1fr) 24px; align-items: center; min-height: 122px; gap: 11px; width: 100%; padding: 5px; border: 1px solid var(--dashboard-border); border-radius: 8px; background: rgba(8, 16, 29, 0.7); color: var(--dashboard-text); text-align: left; cursor: pointer; }
+.inspiration-panel__item:hover { border-color: var(--dashboard-border-strong); background: var(--dashboard-panel-hover); }
+.inspiration-panel .dashboard-thumbnail { width: 104px; height: 110px; }
+.inspiration-panel__content { display: grid; gap: 9px; min-width: 0; }
+.inspiration-panel strong { overflow: hidden; font-size: 14px; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
+.inspiration-panel small { display: -webkit-box; overflow: hidden; color: var(--dashboard-text-muted); font-size: 11px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
+.inspiration-panel__arrow { color: #718099; }
+
+.dashboard-footer { margin: 0 31px 0 calc(var(--dashboard-sidebar-width) + 33px); padding: 18px 0 30px; border-top: 1px solid var(--dashboard-border); color: #5f6c82; font-size: 14px; text-align: center; letter-spacing: 0.04em; }
+
+.dashboard-mobile-nav { display: none; }
+.dashboard-toast { position: fixed; z-index: 50; right: 28px; bottom: 28px; display: flex; align-items: center; gap: 18px; min-width: 280px; padding: 15px 16px 15px 20px; border: 1px solid var(--dashboard-border-strong); border-radius: var(--dashboard-radius-sm); background: rgba(10, 16, 32, 0.96); color: #fff; box-shadow: var(--dashboard-shadow); }
+.dashboard-toast button { display: grid; place-items: center; margin-left: auto; padding: 4px; border: 0; background: transparent; color: var(--dashboard-text-muted); cursor: pointer; }
+.dashboard-toast button:hover { color: #fff; }
+
+@media (max-width: 1280px) {
+  :root { --dashboard-sidebar-width: 232px; }
+  .dashboard-main { padding-inline: 25px; gap: 20px; }
+  .dashboard-primary-grid { grid-template-columns: minmax(320px, 1.35fr) minmax(0, 2.65fr); gap: 14px; }
+  .tool-quick-start__grid { gap: 14px; }
+  .creation-entry-card { padding-inline: 24px; }
+  .tool-quick-start__card { padding-inline: 12px; }
+  .dashboard-content-grid { grid-template-columns: minmax(0, 1.45fr) minmax(405px, 1fr); gap: 14px; }
+  .dashboard-content-grid__side { grid-template-columns: minmax(190px, 0.9fr) minmax(205px, 1.1fr); gap: 12px; }
+  .recent-projects__item { grid-template-columns: 90px minmax(0, 1fr) 72px; }
+  .recent-projects__item .dashboard-thumbnail { width: 90px; }
+  .inspiration-panel__item { grid-template-columns: 72px minmax(0, 1fr) 18px; }
+  .inspiration-panel .dashboard-thumbnail { width: 72px; }
+}
+
+@media (min-width: 1025px) and (max-width: 1199px) {
+  :root { --dashboard-sidebar-width: 220px; }
+  .dashboard-main { padding-inline: 20px; gap: 18px; }
+  .dashboard-primary-grid { grid-template-columns: minmax(280px, 1.35fr) minmax(0, 2.65fr); gap: 12px; }
+  .tool-quick-start__grid { gap: 12px; }
+  .creation-entry-card { grid-template-columns: 48px minmax(0, 1fr); padding: 24px 20px; }
+  .creation-entry-card button { position: absolute; right: 18px; bottom: 18px; }
+  .creation-entry-card p { font-size: 15px; }
+  .creation-entry-card h2 { font-size: 21px; }
+  .tool-quick-start__card > span { top: 43px; }
+  .tool-quick-start__card > strong { font-size: 17px; }
+  .tool-quick-start__card > small { font-size: 12px; }
+  .dashboard-content-grid { grid-template-columns: 1fr; }
+  .dashboard-content-grid__side { grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr); }
+  .recent-projects,
+  .credits-overview,
+  .inspiration-panel { min-height: 350px; }
+}
+
+@media (max-width: 1024px) {
+  :root { --dashboard-sidebar-width: 220px; }
+  .dashboard-main { padding: 16px 20px 32px; gap: 16px; }
+  .dashboard-primary-grid { grid-template-columns: minmax(280px, 1.05fr) minmax(0, 1.95fr); gap: 12px; }
+  .creation-entry-card { min-height: 220px; }
+  .tool-quick-start__grid { gap: 10px; }
+  .tool-quick-start__card { min-height: 220px; }
+  .dashboard-content-grid { grid-template-columns: 1fr; }
+  .dashboard-content-grid__side { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
